@startuml
title Реестр выплат: перегенерация по навыку (правило E-09)

actor "Бухгалтер" as acc
participant "Веб-интерфейс" as web
participant "API Gateway" as api
participant "Сервис реестров" as reg
participant "Сервис выплат" as pay
database "БД реестров" as db
participant "Хранилище файлов" as s3
queue "Очередь событий" as mq

acc -> web : 1 Выбрать файл реестра
web -> api : 2 POST /registries {file, Idempotency-Key}
api -> reg : 3 POST /registries {file, Idempotency-Key, userId}

alt Файл и лимиты в порядке
  reg -> db : 4 INSERT registry (status=UPLOADED, idempotency_key)
  reg -> s3 : 5 PUT file (object_key)
  reg -> db : 6 UPDATE registry (status=VALIDATING)
  reg -> mq : 7 публикация события о загрузке {registry_id}
  reg --> api : 8 202 Accepted {registry_id, status=VALIDATING}
  api --> web : 9 202 Accepted
  web --> acc : 10 Экран «Проверяется»
else Формат или обязательные колонки неверны
  reg --> api : 11 400 {code=FORMAT_INVALID}
  api --> web : 12 400
  web --> acc : 13 Причина отказа
else Лимит строк или суммы превышен
  reg --> api : 14 409 {code=REGISTRY_LIMIT_EXCEEDED}
  api --> web : 15 409
  web --> acc : 16 Сообщение о лимите
end

== Проверка строк ==
mq -> reg : 17 событие о загрузке {registry_id}
reg -> s3 : 18 GET file (object_key)

alt Файл недоступен в хранилище
  reg -> db : 19 UPDATE registry (status=VALIDATION_FAILED)
else Файл получен
  loop По 200 строк
    reg -> db : 20 INSERT rows (status=NEW)
    reg -> pay : 21 POST /payouts/exists:batch {items[{registryId,rowId}]}
    pay --> reg : 22 200 {results[{rowId, paid}]}
    alt paid = true
      reg -> db : 23 UPDATE row (status=REJECTED, reason=ALREADY_PAID)
    end
    reg -> db : 24 UPDATE rows (status=VALIDATED / REJECTED, reject_reason)
  end
  alt Доля отклонённых больше 10%
    reg -> db : 25 UPDATE registry (status=BLOCKED)
  else Ошибок в пределах порога
    reg -> db : 26 UPDATE registry (status=CHECKED)
  end
  reg -> mq : 27 публикация результата проверки {registry_id, status, rejected_count}
end

alt Брокер недоступен
  loop 3 попытки: 1 с, 5 с, 15 с
    reg -> mq : 28 повторная публикация
  end
  reg -> mq : 29 публикация в DLQ {registry_id, reason}
end

== Опрос статуса ==
acc -> web : 30 Обновить экран
web -> api : 31 GET /registries/{id} {If-None-Match: ETag}
api -> reg : 32 GET /registries/{id}
reg -> db : 33 SELECT registry (status, counts, updated_at)
alt ETag совпал
  reg --> api : 34 304 Not Modified
else Состояние изменилось
  reg --> api : 35 200 OK {status, counts, ETag}
end
api --> web : 36 Ответ
web --> acc : 37 Статус и счётчики

== Разбор отклонённых строк ==
acc -> web : 38 Открыть отклонённые строки
web -> api : 39 GET /registries/{id}/rows {status=REJECTED, limit=50, offset=0}
api -> reg : 40 GET /registries/{id}/rows
reg -> db : 41 SELECT rows (reject_reason, amount, inn_masked)
reg --> api : 42 200 {items[{rowId, rejectReason, rejectMessage}], total}
api --> web : 43 Ответ
web --> acc : 44 Список причин отказа

== Повторная проверка после сбоя ==
acc -> web : 45 Отправить на повторную проверку
web -> api : 46 POST /registries/{id}/revalidation {Idempotency-Key}
api -> reg : 47 POST /registries/{id}/revalidation
alt Статус не VALIDATION_FAILED
  reg --> api : 48 409 {code=REGISTRY_NOT_VALIDATION_FAILED}
else Реестр в VALIDATION_FAILED
  reg -> db : 49 UPDATE registry (status=VALIDATING)
  reg -> mq : 50 публикация запроса повторной проверки {registry_id}
  reg --> api : 51 202 Accepted {status=VALIDATING}
end

@enduml
